# Production (ECS / RDS / SQS). Do not commit real values — set these in the task
# definition or Secrets Manager. Copy only as a checklist of required vars.
#
# DATABASE_URL and HTTP_ADDR apply to builder-api, execution-api, and the worker.
# SQS_* / AWS_REGION apply to execution-api and the worker.
# Do not set AWS_ENDPOINT_URL in production (task role + real SQS).

DATABASE_URL=postgres://USER:PASSWORD@ORCHEX_RDS_HOST:5432/orchex?sslmode=require
HTTP_ADDR=:8080
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/orchex-node-jobs
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/orchex-node-jobs-dlq
AWS_REGION=ap-south-1
