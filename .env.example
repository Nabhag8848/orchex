# Local development (docker compose + host tools).
# Copy to .env:  cp .env.example .env
#
# DATABASE_URL uses localhost for goose/make run on the host.
# Compose overrides it to the "postgres" service hostname for containers.
# Compose also points execution-api / execution-worker at ElasticMQ (not AWS).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchex
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@localhost:5432/orchex?sslmode=disable
HTTP_ADDR=:8080
HTTP_PORT=8080
EXECUTION_HTTP_PORT=8081
WORKER_HTTP_PORT=8082

# Host binaries against Compose ElasticMQ (make run-execution / run-worker).
# Leave AWS_ENDPOINT_URL empty to use real AWS SQS instead.
SQS_QUEUE_URL=http://localhost:9324/000000000000/orchex-node-jobs
AWS_ENDPOINT_URL=http://localhost:9324
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
