# Local development (docker compose + host tools).
# Copy to .env:  cp .env.example .env
#
# DATABASE_URL uses localhost for goose/make run on the host.
# Compose overrides it to the "postgres" service hostname for containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchex
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@localhost:5432/orchex?sslmode=disable
HTTP_ADDR=:8080
HTTP_PORT=8080
EXECUTION_HTTP_PORT=8081
