# Local development (docker compose + host tools).
# Copy to .env:  cp .env.example .env
#
# Compose points execution-api / execution-worker at ElasticMQ (SQS) and optional SAM (Lambda).
#
# Production (ECS): leave AWS_ENDPOINT_URL and LAMBDA_ENDPOINT_URL unset.
# Terraform sets FUNCTION_SANDBOX_ARN to the real Lambda ARN and uses the task role.
# DATABASE_URL uses localhost for goose/make run on the host.
# Compose overrides it to the "postgres" service hostname for containers.
#

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchex
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@localhost:5432/orchex?sslmode=disable
HTTP_ADDR=:8080
HTTP_PORT=8080
EXECUTION_HTTP_PORT=8081
WORKER_HTTP_PORT=8082

# Host binaries against Compose ElasticMQ (make run-execution / run-worker).
# Leave AWS_ENDPOINT_URL empty to use real AWS SQS instead.
SQS_QUEUE_URL=http://localhost:9324/000000000000/orchex-node-jobs
AWS_ENDPOINT_URL=http://localhost:9324
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Shared Function sandbox via SAM (sam local start-lambda --port 3001).
# Leave LAMBDA_ENDPOINT_URL empty to use real AWS Lambda (prod).
# Compose worker overrides LAMBDA_ENDPOINT_URL to host.docker.internal:3001.
FUNCTION_SANDBOX_ARN=orchex-function-sandbox
LAMBDA_ENDPOINT_URL=http://localhost:3001
